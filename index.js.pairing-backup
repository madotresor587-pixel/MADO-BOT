require("dotenv").config();

const {
  default: makeWASocket,
  useMultiFileAuthState,
  DisconnectReason
} = require("@whiskeysockets/baileys");

const pino = require("pino");
const config = require("./config");
const fs = require("fs");

const SESSION_DIR = "./session";

function cleanPhoneNumber(number) {
  return String(number || "").replace(/\D/g, "");
}

async function startBot() {
  console.log("🚀 Démarrage de MADO...");

  const { state, saveCreds } =
    await useMultiFileAuthState(SESSION_DIR);

  const sock = makeWASocket({
    auth: state,
    logger: pino({ level: "silent" }),
    printQRInTerminal: false,
    browser: [
      config.BOT_NAME || "MADO",
      "Chrome",
      "1.0.0"
    ],
    markOnlineOnConnect: false
  });

  sock.ev.on("creds.update", saveCreds);

  /*
   * CODE PAIRING
   */
  if (!state.creds.registered) {
    const phoneNumber = cleanPhoneNumber(process.env.BOT_NUMBER);

    if (!phoneNumber) {
      console.log("");
      console.log("❌ BOT_NUMBER n'est pas configuré dans .env");
      console.log("Exemple : BOT_NUMBER=225XXXXXXXXXX");
      console.log("");
      process.exit(1);
    }

    try {
      // Petit délai pour laisser la connexion s'initialiser
      setTimeout(async () => {
        try {
          const code = await sock.requestPairingCode(phoneNumber);

          console.log("");
          console.log("======================================");
          console.log("        🤖 MADO - CODE PAIRING");
          console.log("======================================");
          console.log("");
          console.log("📱 Numéro :", phoneNumber);
          console.log("🔑 CODE   :", code);
          console.log("");
          console.log("Sur WhatsApp :");
          console.log("Appareils liés");
          console.log("→ Lier un appareil");
          console.log("→ Lier avec numéro de téléphone");
          console.log("→ Entre le code ci-dessus");
          console.log("");
          console.log("======================================");
          console.log("");
        } catch (error) {
          console.log("❌ Impossible de générer le Code Pairing.");
          console.log(error?.message || error);
        }
      }, 3000);
    } catch (error) {
      console.log("❌ Erreur Code Pairing :", error?.message || error);
    }
  }

  sock.ev.on("connection.update", async (update) => {
    const { connection, lastDisconnect } = update;

    if (connection === "open") {
      console.log("");
      console.log("======================================");
      console.log("       ✅ MADO-BOT CONNECTÉ !");
      console.log("======================================");
      console.log("");
    }

    if (connection === "close") {
      const statusCode =
        lastDisconnect?.error?.output?.statusCode;

      const shouldReconnect =
        statusCode !== DisconnectReason.loggedOut;

      console.log("");
      console.log("❌ Connexion fermée.");
      console.log("Code :", statusCode || "inconnu");

      if (shouldReconnect) {
        console.log("🔄 Reconnexion de MADO...");
        setTimeout(() => startBot(), 3000);
      } else {
        console.log("🔐 Session déconnectée.");
        console.log("Supprime le dossier session puis relance MADO si nécessaire.");
      }
    }
  });

  /*
   * Vérification de la bibliothèque lib
   */
  try {
    const files = fs.readdirSync("./lib");
    console.log("📁 Lib :", files.join(", "));
  } catch {
    console.log("⚠️ Dossier ./lib introuvable.");
  }
}

startBot().catch((error) => {
  console.error("❌ Erreur MADO :", error);
});
