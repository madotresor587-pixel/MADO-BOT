const {
  default: makeWASocket,
  useMultiFileAuthState,
  DisconnectReason
} = require("@whiskeysockets/baileys");

const pino = require("pino");

const {
  BOT_NAME,
  PREFIX,
  BOT_NUMBER,
  SESSION_DIR
} = require("./config");

const {
  getCommand,
  getMessageText
} = require("./lib/helpers");

const { ensureDatabase } = require("./lib/database");

const { handleOwner } = require("./commands/owner");
const { handleGeneral } = require("./commands/general");
const { handleAI } = require("./commands/ai");
const { handleTools } = require("./commands/tools");
const { handleProfile } = require("./commands/profile");
const { handleDiagnostic } = require("./commands/diagnostic");
const { handleGroup } = require("./commands/group");
const { handleGroupTools } = require("./commands/group-tools");
const { handleGroupInfo } = require("./commands/group-info");
const { handleGroupAdvanced } = require("./commands/group-advanced");
const { handleAdmin } = require("./commands/admin");
const { handleModeration } = require("./commands/moderation");
const { handleWelcome } = require("./commands/welcome");
const { handleAnti, processAnti } = require("./commands/anti");
const {
  handleAntiMedia,
  processAntiMedia
} = require("./commands/anti-media");
const { handlePolls } = require("./commands/polls");
const { handleFun } = require("./commands/fun");
const { handleGames } = require("./commands/games");
const { handleUtility } = require("./commands/utility");
const { handleExtra } = require("./commands/extra");
const { handleMedia } = require("./commands/media");
const { handleStatus } = require("./commands/status");
const { handleFiles } = require("./commands/files");
const { handleAdvanced } = require("./commands/advanced");
const { handleInfoTools } = require("./commands/info-tools");
const { handleMessageTools } = require("./commands/message-tools");
const { handleUseful } = require("./commands/useful");
const { handleFinalTools } = require("./commands/final-tools");
const { handleLastTools } = require("./commands/last-tools");
const { handleAITools } = require("./commands/ai-tools");
const { handleKamramStyle } = require("./commands/kamram-style");

const {
  welcomeHandler
} = require("./commands/welcome");

ensureDatabase();

let reconnecting = false;

function cleanNumber(number) {
  return String(number || "")
    .replace(/\D/g, "");
}

function isLoggedIn(state) {
  return Boolean(state?.creds?.registered);
}

async function handleCommand(sock, message) {
  try {
    const jid = message?.key?.remoteJid;

    if (!jid) return;

    if (message.key?.fromMe) return;

    const text = getMessageText(message);

    if (!text) return;

    const parsed = getCommand(text, PREFIX);

    if (!parsed) return;

    const { command, args } = parsed;

    /*
     * PROPRIÉTAIRE
     * On limite ici les commandes réellement réservées
     * au propriétaire afin de ne pas bloquer les autres commandes.
     */
    if (command === "owner" || command === "botinfo") {
      if (await handleOwner(command, sock, jid, message)) {
        return;
      }
    }

    const handlers = [
      () => handleGeneral(command, sock, jid, message),
      () => handleAI(command, args, sock, jid, message),
      () => handleAITools(command, args, sock, jid, message),
      () => handleAdmin(command, args, sock, jid, message),
      () => handleModeration(command, args, sock, jid, message),
      () => handleWelcome(command, args, sock, jid, message),
      () => handleAnti(command, args, sock, jid, message),
      () => handleAntiMedia(command, args, sock, jid, message),
      () => handlePolls(command, args, sock, jid, message),
      () => handleGroup(command, args, sock, jid, message),
      () => handleGroupTools(command, args, sock, jid, message),
      () => handleGroupInfo(command, args, sock, jid, message),
      () => handleGroupAdvanced(command, args, sock, jid, message),
      () => handleTools(command, args, sock, jid, message),
      () => handleProfile(command, args, sock, jid, message),
      () => handleDiagnostic(command, args, sock, jid, message),
      () => handleFun(command, args, sock, jid, message),
      () => handleGames(command, args, sock, jid, message),
      () => handleUtility(command, args, sock, jid, message),
      () => handleExtra(command, args, sock, jid, message),
      () => handleMedia(command, args, sock, jid, message),
      () => handleStatus(command, args, sock, jid, message),
      () => handleFiles(command, args, sock, jid, message),
      () => handleAdvanced(command, args, sock, jid, message),
      () => handleInfoTools(command, args, sock, jid, message),
      () => handleMessageTools(command, args, sock, jid, message),
      () => handleUseful(command, args, sock, jid, message),
      () => handleFinalTools(command, args, sock, jid, message),
      () => handleLastTools(command, args, sock, jid, message),
      () => handleKamramStyle(command, args, sock, jid, message)
    ];

    for (const handler of handlers) {
      try {
        const handled = await handler();

        if (handled === true) {
          return;
        }
      } catch (error) {
        console.log(
          `❌ Erreur commande .${command}:`,
          error.message
        );

        await sock.sendMessage(jid, {
          text:
            "❌ Une erreur est survenue pendant l'exécution de la commande."
        });

        return;
      }
    }

    await sock.sendMessage(jid, {
      text:
        `❓ Commande inconnue : *${PREFIX}${command}*\n\n` +
        `Utilise *${PREFIX}menu* pour voir les commandes.`
    });

  } catch (error) {
    console.log("❌ Erreur handleCommand :", error.message);
  }
}

async function startMado() {
  if (reconnecting) return;

  const {
    state,
    saveCreds
  } = await useMultiFileAuthState(
    SESSION_DIR || "./session"
  );

  const sock = makeWASocket({
    auth: state,
    logger: pino({
      level: "silent"
    }),
    browser: [
      BOT_NAME,
      "Chrome",
      "1.0.0"
    ],
    markOnlineOnConnect: false
  });

  sock.ev.on("creds.update", saveCreds);

  /*
   * CODE DE JUMELAGE
   */
  if (!isLoggedIn(state)) {
    const number = cleanNumber(BOT_NUMBER);

    if (!number) {
      console.log("");
      console.log("❌ BOT_NUMBER n'est pas configuré.");
      console.log("");
      console.log(
        "Ajoute le numéro WhatsApp du compte qui doit devenir Mado dans .env :"
      );
      console.log("");
      console.log("BOT_NUMBER=225XXXXXXXXXX");
      console.log("");
      return;
    }

    try {
      const code = await sock.requestPairingCode(number);

      console.log("");
      console.log("================================");
      console.log("       🤖 MADO WHATSAPP");
      console.log("================================");
      console.log("");
      console.log("🔗 CODE DE JUMELAGE :");
      console.log("");
      console.log(`        ${code}`);
      console.log("");
      console.log(
        "Ouvre WhatsApp > Appareils connectés > Connecter un appareil."
      );
      console.log("");
      console.log("================================");
      console.log("");
    } catch (error) {
      console.log(
        "❌ Impossible de générer le code :",
        error.message
      );
    }
  }

  sock.ev.on(
    "connection.update",
    async (update) => {
      const {
        connection,
        lastDisconnect
      } = update;

      if (connection === "open") {
        reconnecting = false;

        console.log("");
        console.log("================================");
        console.log("       ✅ MADO EST EN LIGNE");
        console.log("================================");
        console.log("");
        console.log(`🤖 Nom : ${BOT_NAME}`);
        console.log(`⚙️ Préfixe : ${PREFIX}`);
        console.log("🌍 Multilingue : activé");
        console.log("📱 WhatsApp : connecté");
        console.log("");
      }

      if (connection === "close") {
        const statusCode =
          lastDisconnect?.error?.output?.statusCode;

        console.log("");
        console.log("⚠️ Connexion WhatsApp fermée.");
        console.log(
          `Code : ${statusCode || "inconnu"}`
        );

        if (
          statusCode !== DisconnectReason.loggedOut
        ) {
          reconnecting = true;

          console.log(
            "🔄 Reconnexion de Mado..."
          );

          setTimeout(() => {
            reconnecting = false;
            startMado().catch((error) => {
              console.log(
                "❌ Erreur reconnexion :",
                error.message
              );
            });
          }, 5000);
        } else {
          console.log(
            "🚪 Mado a été déconnecté de WhatsApp."
          );
          console.log(
            "Supprime le dossier session puis relance si nécessaire."
          );
        }
      }
    }
  );

  sock.ev.on(
    "messages.upsert",
    async ({ messages }) => {
      for (const message of messages) {
        try {
          if (!message?.message) continue;

          /*
           * Protections automatiques
           */
          try {
            await processAnti(
              message,
              sock
            );
          } catch (error) {
            console.log(
              "⚠️ Erreur Anti :",
              error.message
            );
          }

          try {
            await processAntiMedia(
              message,
              sock
            );
          } catch (error) {
            console.log(
              "⚠️ Erreur Anti-Media :",
              error.message
            );
          }

          /*
           * Commandes
           */
          await handleCommand(
            sock,
            message
          );

        } catch (error) {
          console.log(
            "❌ Erreur message :",
            error.message
          );
        }
      }
    }
  );

  sock.ev.on(
    "group-participants.update",
    async (update) => {
      try {
        await welcomeHandler(
          update,
          sock
        );
      } catch (error) {
        console.log(
          "⚠️ Erreur Welcome :",
          error.message
        );
      }
    }
  );

  return sock;
}

process.on(
  "uncaughtException",
  (error) => {
    console.log(
      "⚠️ Erreur système :",
      error.message
    );
  }
);

process.on(
  "unhandledRejection",
  (error) => {
    console.log(
      "⚠️ Promesse non gérée :",
      error?.message || error
    );
  }
);

console.log("");
console.log("🚀 Démarrage de Mado...");
console.log("");

startMado().catch((error) => {
  console.log(
    "❌ Impossible de démarrer Mado :",
    error.message
  );
});