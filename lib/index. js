const {
  default: makeWASocket,
  useMultiFileAuthState,
  DisconnectReason
} = require("@whiskeysockets/baileys");

const pino = require("pino");

const { PREFIX, BOT_NAME, SESSION_DIR } = require("./config");
const { getCommand, getMessageText } = require("./lib/helpers");
const { menu } = require("./lib/menu");

const { handleGeneral } = require("./commands/general");
const { handleAI } = require("./commands/ai");
const { handleTools } = require("./commands/tools");
const { handleOwner } = require("./commands/owner");
const { handleExtra } = require("./commands/extra");
const { handleGroup } = require("./commands/group");
const { handleMedia } = require("./commands/media");
const { handleAdmin } = require("./commands/admin");
const { handleWelcome, welcomeHandler } = require("./commands/welcome");
const { handleAnti, processAnti } = require("./commands/anti");
const {
  handleAntiMedia,
  processAntiMedia
} = require("./commands/anti-media");
const { handleFun } = require("./commands/fun");
const { handleStatus } = require("./commands/status");
const { handleProfile } = require("./commands/profile");
const { handleUtility } = require("./commands/utility");
const { handleDiagnostic } = require("./commands/diagnostic");
const { handleGroupTools } = require("./commands/group-tools");
const { handleModeration } = require("./commands/moderation");
const { handleGroupInfo } = require("./commands/group-info");
const { handleFiles } = require("./commands/files");
const { handlePolls } = require("./commands/polls");
const { handleKamramStyle } = require("./commands/kamram-style");
const { handleAITools } = require("./commands/ai-tools");
const { handleGames } = require("./commands/games");
const { handleAdvanced } = require("./commands/advanced");
const { handleInfoTools } = require("./commands/info-tools");
const { handleMessageTools } = require("./commands/message-tools");
const { handleUseful } = require("./commands/useful");
const { handleGroupAdvanced } = require("./commands/group-advanced");
const { handleFinalTools } = require("./commands/final-tools");
const { handleLastTools } = require("./commands/last-tools");

let reconnecting = false;

async function startBot() {
  const { state, saveCreds } =
    await useMultiFileAuthState(SESSION_DIR || "./session");

  const sock = makeWASocket({
    auth: state,
    logger: pino({ level: "silent" }),
    browser: [BOT_NAME, "Chrome", "1.0.0"]
  });

  sock.ev.on("creds.update", saveCreds);

  sock.ev.on(
    "connection.update",
    async ({ connection, lastDisconnect }) => {

      if (connection === "open") {
        reconnecting = false;

        console.log(`
╔════════════════════════════╗
║       🤖 ${BOT_NAME}
║       🟢 CONNECTÉ
╚════════════════════════════╝
        `);
      }

      if (connection === "close") {
        const code =
          lastDisconnect?.error?.output?.statusCode;

        const loggedOut =
          code === DisconnectReason.loggedOut;

        if (!loggedOut && !reconnecting) {
          reconnecting = true;

          console.log("🔄 Reconnexion de Mado...");

          setTimeout(() => {
            startBot().catch(console.error);
          }, 3000);
        } else if (loggedOut) {
          console.log(
            "❌ Session déconnectée. Supprime le dossier session puis reconnecte le bot."
          );
        }
      }
    }
  );

  /*
   * Messages entrants
   */
  sock.ev.on("messages.upsert", async ({ messages }) => {
    try {
      const message = messages?.[0];

      if (!message?.message) return;
      if (message.key.fromMe) return;

      const jid = message.key.remoteJid;

      if (!jid) return;

      /*
       * Protection anti-abus
       * exécutée avant les commandes
       */
      await processAnti(message, sock);
      await processAntiMedia(message, sock);

      const text = getMessageText(message);

      if (!text) return;

      if (!text.startsWith(PREFIX)) return;

      const parsed = getCommand(text, PREFIX);

      if (!parsed) return;

      const {
        command,
        args,
        text: argsText
      } = parsed;

      /*
       * Liste des handlers
       */

      if (
        await handleOwner(
          command,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleGeneral(
          command,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleAI(
          command,
          argsText,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleAITools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleTools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleExtra(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleGroup(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleAdmin(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleWelcome(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleAnti(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleAntiMedia(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleFun(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleGames(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleStatus(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleProfile(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleUtility(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleDiagnostic(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleGroupTools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleModeration(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleGroupInfo(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleFiles(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handlePolls(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleKamramStyle(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleAdvanced(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleInfoTools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleMessageTools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleUseful(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleGroupAdvanced(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleFinalTools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      if (
        await handleLastTools(
          command,
          args,
          sock,
          jid,
          message
        )
      ) return;

      /*
       * Commande inconnue
       */
      await sock.sendMessage(jid, {
        text:
          `❓ Commande inconnue : ${PREFIX}${command}\n\n` +
          `Tape ${PREFIX}menu pour voir les commandes.`
      });

    } catch (error) {
      console.error("Erreur message :", error);

      try {
        const jid = messages?.[0]?.key?.remoteJid;

        if (jid) {
          await sock.sendMessage(jid, {
            text: "❌ Une erreur est survenue pendant le traitement."
          });
        }
      } catch {}
    }
  });

  /*
   * Arrivée / départ des membres
   */
  sock.ev.on(
    "group-participants.update",
    async update => {
      try {
        await welcomeHandler(update, sock);
      } catch (error) {
        console.error(
          "Erreur welcome :",
          error
        );
      }
    }
  );
}

startBot().catch(error => {
  console.error(
    "❌ Impossible de démarrer Mado :",
    error
  );
});