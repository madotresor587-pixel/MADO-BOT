const os = require("os");

const startedAt = Date.now();

function formatUptime(ms) {
  const seconds = Math.floor(ms / 1000);
  const days = Math.floor(seconds / 86400);
  const hours = Math.floor((seconds % 86400) / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const secs = seconds % 60;

  return `${days}j ${hours}h ${minutes}m ${secs}s`;
}

async function handleDiagnostic(command, args, sock, jid) {
  switch (command) {

    case "bug":
    case "bugs":
      await sock.sendMessage(jid, {
        text:
          "🐞 *SIGNALER UN PROBLÈME*\n\n" +
          "Envoie une description du problème rencontré."
      });
      return true;

    case "diagnostic":
      await sock.sendMessage(jid, {
        text:
          "🔧 *DIAGNOSTIC MADO*\n\n" +
          "✅ Moteur : opérationnel\n" +
          "✅ Réponse : opérationnelle\n" +
          "✅ Commandes : chargées\n" +
          "🤖 État : actif"
      });
      return true;

    case "statusbot":
      await sock.sendMessage(jid, {
        text:
          "🤖 *STATUT MADO*\n\n" +
          "🟢 En ligne\n" +
          "⚡ Système opérationnel"
      });
      return true;

    case "memory": {
      const memory = process.memoryUsage();

      await sock.sendMessage(jid, {
        text:
          "💾 *MÉMOIRE*\n\n" +
          `RAM utilisée : ${(memory.rss / 1024 / 1024).toFixed(1)} MB\n` +
          `Heap : ${(memory.heapUsed / 1024 / 1024).toFixed(1)} MB`
      });
      return true;
    }

    case "uptime":
      await sock.sendMessage(jid, {
        text:
          `⏱️ *Uptime Mado*\n\n${formatUptime(
            Date.now() - startedAt
          )}`
      });
      return true;

    default:
      return false;
  }
}

module.exports = {
  handleDiagnostic
};