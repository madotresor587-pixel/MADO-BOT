async function handleTools(command, sock, jid) {
  switch (command) {
    case "say":
      await sock.sendMessage(jid, {
        text: "Utilise .say suivi du texte à répéter."
      });
      return true;

    case "date":
      await sock.sendMessage(jid, {
        text: `📅 ${new Date().toLocaleDateString()}`
      });
      return true;

    default:
      return false;
  }
}

module.exports = { handleTools };