async function handleGroupAdvanced(command, args, sock, jid, message) {
  const commands = [
    "adminslist",
    "groupmembers",
    "groupdesc",
    "groupname",
    "groupprivacy",
    "tagadmins",
    "tagmembers",
    "groupstatus",
    "grouphelp",
    "botadmin"
  ];

  if (!commands.includes(command)) return false;

  if (!jid.endsWith("@g.us")) {
    await sock.sendMessage(jid, {
      text: "❌ Cette commande fonctionne uniquement dans un groupe."
    });
    return true;
  }

  try {
    const metadata = await sock.groupMetadata(jid);
    const participants = metadata.participants || [];

    const sender =
      message.key.participant ||
      message.key.remoteJid;

    const senderMember = participants.find(
      p => p.id === sender
    );

    const isAdmin =
      senderMember?.admin === "admin" ||
      senderMember?.admin === "superadmin";

    if (command === "adminslist") {
      const admins = participants.filter(
        p => p.admin === "admin" || p.admin === "superadmin"
      );

      const list = admins
        .map((p, i) => `${i + 1}. @${p.id.split("@")[0]}`)
        .join("\n");

      await sock.sendMessage(jid, {
        text: `👑 *ADMINS*\n\n${list || "Aucun admin."}`,
        mentions: admins.map(p => p.id)
      });

      return true;
    }

    if (command === "groupmembers") {
      await sock.sendMessage(jid, {
        text:
          `👥 *MEMBRES*\n\n` +
          `Nombre total : *${participants.length}*`
      });

      return true;
    }

    if (command === "groupdesc") {
      await sock.sendMessage(jid, {
        text:
          `📝 *DESCRIPTION DU GROUPE*\n\n` +
          `${metadata.desc || "Aucune description."}`
      });

      return true;
    }

    if (command === "groupname") {
      await sock.sendMessage(jid, {
        text: `📛 Nom du groupe : *${metadata.subject}*`
      });

      return true;
    }

    if (command === "groupprivacy") {
      await sock.sendMessage(jid, {
        text:
          "🔐 *INFORMATIONS GROUPE*\n\n" +
          "Les changements de paramètres sont réservés aux administrateurs."
      });

      return true;
    }

    if (command === "tagadmins") {
      const admins = participants.filter(
        p => p.admin === "admin" || p.admin === "superadmin"
      );

      const mentions = admins.map(p => p.id);

      const text = admins
        .map(p => `@${p.id.split("@")[0]}`)
        .join(" ");

      await sock.sendMessage(jid, {
        text: `📢 *ADMINS*\n\n${text}`,
        mentions
      });

      return true;
    }

    if (command === "tagmembers") {
      const mentions = participants.map(p => p.id);

      const text = participants
        .map(p => `@${p.id.split("@")[0]}`)
        .join(" ");

      await sock.sendMessage(jid, {
        text: `👥 *MEMBRES*\n\n${text}`,
        mentions
      });

      return true;
    }

    if (command === "groupstatus") {
      await sock.sendMessage(jid, {
        text:
          `📊 *STATUT DU GROUPE*\n\n` +
          `📛 ${metadata.subject}\n` +
          `👥 ${participants.length} membres\n` +
          `🛡️ ${participants.filter(
            p => p.admin === "admin" || p.admin === "superadmin"
          ).length} administrateur(s)`
      });

      return true;
    }

    if (command === "botadmin") {
      const botJid = sock.user?.id?.split(":")[0] + "@s.whatsapp.net";

      const botMember = participants.find(
        p => p.id === botJid
      );

      await sock.sendMessage(jid, {
        text:
          botMember?.admin
            ? "✅ MADO-BOT est administrateur de ce groupe."
            : "ℹ️ MADO-BOT n'est pas administrateur de ce groupe."
      });

      return true;
    }

    if (command === "grouphelp") {
      await sock.sendMessage(jid, {
        text:
          "👥 *COMMANDES GROUPE*\n\n" +
          ".adminslist\n" +
          ".groupmembers\n" +
          ".groupdesc\n" +
          ".groupname\n" +
          ".groupprivacy\n" +
          ".tagadmins\n" +
          ".tagmembers\n" +
          ".groupstatus\n" +
          ".botadmin"
      });

      return true;
    }

  } catch (error) {
    console.error(error);

    await sock.sendMessage(jid, {
      text: "❌ Impossible de récupérer les informations du groupe."
    });

    return true;
  }

  return false;
}

module.exports = { handleGroupAdvanced };