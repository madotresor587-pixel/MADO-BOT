const polls = new Map();

async function handlePolls(command, args, sock, jid) {
  switch (command) {

    case "poll":
      if (args.length < 2) {
        await sock.sendMessage(jid, {
          text:
            "❌ Utilisation : .poll Question | Option 1 | Option 2\n\n" +
            "Exemple : .poll Quel jeu ? | FIFA | PES"
        });
        return true;
      }

      const parts = args.join(" ")
        .split("|")
        .map(x => x.trim())
        .filter(Boolean);

      if (parts.length < 3) {
        await sock.sendMessage(jid, {
          text: "❌ Il faut une question et au moins 2 options."
        });
        return true;
      }

      const question = parts[0];
      const options = parts.slice(1);

      polls.set(jid, {
        question,
        options,
        votes: new Map()
      });

      await sock.sendMessage(jid, {
        text:
          `📊 *SONDAGE*\n\n` +
          `❓ ${question}\n\n` +
          options.map((x, i) => `${i + 1}. ${x}`).join("\n") +
          `\n\n💬 Vote avec : .vote numéro`
      });

      return true;

    case "vote": {
      const poll = polls.get(jid);

      if (!poll) {
        await sock.sendMessage(jid, {
          text: "❌ Aucun sondage actif."
        });
        return true;
      }

      const choice = Number(args[0]);

      if (
        !Number.isInteger(choice) ||
        choice < 1 ||
        choice > poll.options.length
      ) {
        await sock.sendMessage(jid, {
          text: `❌ Choisis un numéro entre 1 et ${poll.options.length}.`
        });
        return true;
      }

      const sender = jid;

      poll.votes.set(
        `${sender}-${Date.now()}`,
        choice
      );

      await sock.sendMessage(jid, {
        text: `✅ Vote enregistré pour : *${poll.options[choice - 1]}*`
      });

      return true;
    }

    case "pollresult": {
      const poll = polls.get(jid);

      if (!poll) {
        await sock.sendMessage(jid, {
          text: "❌ Aucun sondage actif."
        });
        return true;
      }

      const counts = poll.options.map(
        (_, index) =>
          [...poll.votes.values()]
            .filter(vote => vote === index + 1).length
      );

      const result = poll.options
        .map(
          (option, index) =>
            `${index + 1}. ${option} — ${counts[index]} vote(s)`
        )
        .join("\n");

      await sock.sendMessage(jid, {
        text:
          `📊 *RÉSULTATS*\n\n` +
          `❓ ${poll.question}\n\n${result}`
      });

      return true;
    }

    case "pollclose":
      if (!polls.has(jid)) {
        await sock.sendMessage(jid, {
          text: "❌ Aucun sondage actif."
        });
        return true;
      }

      polls.delete(jid);

      await sock.sendMessage(jid, {
        text: "🔒 Sondage fermé."
      });

      return true;

    case "pollhelp":
      await sock.sendMessage(jid, {
        text:
          "📊 *COMMANDES SONDAGE*\n\n" +
          "• .poll Question | Option 1 | Option 2\n" +
          "• .vote 1\n" +
          "• .pollresult\n" +
          "• .pollclose\n" +
          "• .pollhelp"
      });
      return true;

    default:
      return false;
  }
}

module.exports = { handlePolls };