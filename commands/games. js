const truthQuestions = [
  "Quel est ton rêve le plus grand ?",
  "Quelle est ta matière préférée ?",
  "Quel pays aimerais-tu visiter ?",
  "Quel est ton jeu préféré ?",
  "Quelle compétence aimerais-tu apprendre ?"
];

const dares = [
  "Écris une phrase drôle dans le groupe.",
  "Envoie ton emoji préféré.",
  "Écris une phrase sans utiliser la lettre A.",
  "Donne trois mots qui commencent par M.",
  "Écris une mini-blague."
];

async function handleGames(command, args, sock, jid) {
  switch (command) {

    case "dicegame": {
      const a = Math.floor(Math.random() * 6) + 1;
      const b = Math.floor(Math.random() * 6) + 1;

      await sock.sendMessage(jid, {
        text:
          `🎲 *DÉ DE MADO-BOT*\n\n` +
          `Résultat : *${a} + ${b} = ${a + b}*`
      });

      return true;
    }

    case "coinflip": {
      const result =
        Math.random() < 0.5 ? "PILE 🪙" : "FACE 🪙";

      await sock.sendMessage(jid, {
        text: `🪙 Résultat : *${result}*`
      });

      return true;
    }

    case "truth": {
      const question =
        truthQuestions[
          Math.floor(Math.random() * truthQuestions.length)
        ];

      await sock.sendMessage(jid, {
        text: `🎯 *VÉRITÉ*\n\n${question}`
      });

      return true;
    }

    case "dare": {
      const dare =
        dares[Math.floor(Math.random() * dares.length)];

      await sock.sendMessage(jid, {
        text: `🎯 *DÉFI*\n\n${dare}`
      });

      return true;
    }

    case "randomemoji": {
      const emojis = [
        "😂", "🔥", "❤️", "😎", "🎮",
        "🚀", "⭐", "🤣", "🤖", "🎯"
      ];

      const emoji =
        emojis[Math.floor(Math.random() * emojis.length)];

      await sock.sendMessage(jid, {
        text: `🎲 Emoji aléatoire : ${emoji}`
      });

      return true;
    }

    case "numbergame": {
      const number = Math.floor(Math.random() * 100) + 1;

      await sock.sendMessage(jid, {
        text:
          "🔢 *NOMBRE MYSTÈRE*\n\n" +
          "J'ai choisi un nombre entre 1 et 100.\n" +
          `Indice : le nombre est *${number % 2 === 0 ? "pair" : "impair"}*.`
      });

      return true;
    }

    case "riddle": {
      await sock.sendMessage(jid, {
        text:
          "🧩 *ÉNIGME*\n\n" +
          "Je suis toujours devant toi mais tu ne peux jamais me voir. Qui suis-je ?"
      });

      return true;
    }

    case "luck": {
      const score = Math.floor(Math.random() * 101);

      await sock.sendMessage(jid, {
        text: `🍀 Ton score de chance aujourd'hui : *${score}/100*`
      });

      return true;
    }

    case "gamehelp": {
      await sock.sendMessage(jid, {
        text:
          "🎮 *JEUX MADO-BOT*\n\n" +
          ".dicegame\n" +
          ".coinflip\n" +
          ".truth\n" +
          ".dare\n" +
          ".randomemoji\n" +
          ".numbergame\n" +
          ".riddle\n" +
          ".luck"
      });

      return true;
    }

    case "quizrandom": {
      const questions = [
        "Quelle est la capitale de la Côte d’Ivoire ?",
        "Combien de continents existe-t-il ?",
        "Quelle planète est surnommée la planète rouge ?",
        "Combien font 12 × 8 ?"
      ];

      const question =
        questions[Math.floor(Math.random() * questions.length)];

      await sock.sendMessage(jid, {
        text: `🧠 *QUIZ*\n\n${question}`
      });

      return true;
    }

    default:
      return false;
  }
}

module.exports = { handleGames };