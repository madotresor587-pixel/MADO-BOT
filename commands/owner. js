const { OWNER_NUMBER } = require("../config");

function isOwner(jid) {
  const number = jid.split("@")[0];
  return OWNER_NUMBER && number === OWNER_NUMBER;
}

async function handleOwner(command, sock, jid) {
  if (!["owner", "restart"].includes(command)) return false;

  if (!isOwner(jid)) {
    await sock.sendMessage(jid, {
      text: "⛔ Cette commande est réservée au propriétaire."
    });
    return true;
  }

  if (command === "owner") {
    await sock.sendMessage(jid, {
      text: "👑 Tu es le propriétaire de MADO-BOT."
    });
  }

  if (command === "restart") {
    await sock.sendMessage(jid, {
      text: "🔄 Redémarrage demandé."
    });
    process.exit(0);
  }

  return true;
}

module.exports = { handleOwner };