async function handleGroup(command, args, sock, jid, message) {
  const groupCommands = [
    "groupinfo",
    "admins",
    "members",
    "tagall"
  ];

  if (!groupCommands.includes(command)) return false;

  if (!jid.endsWith("@g.us")) {
    await sock.sendMessage(jid, {
      text: "❌ Cette commande fonctionne uniquement dans un groupe."
    });
    return true;
  }

  const metadata = await sock.groupMetadata(jid);
  const participants = metadata.participants || [];

  if (command === "groupinfo") {
    await sock.sendMessage(jid, {
      text:
        `👥 *INFOS DU GROUPE*\n\n` +
        `📛 Nom : ${metadata.subject}\n` +
        `👤 Membres : ${participants.length}\n` +
        `🆔 ID : ${jid}`
    });
    return true;
  }

  if (command === "admins") {
    const admins = participants.filter(
      p => p.admin === "admin" || p.admin === "superadmin"
    );

    const list = admins
      .map((p, i) => `${i + 1}. @${p.id.split("@")[0]}`)
      .join("\n");

    await sock.sendMessage(jid, {
      text: `👑 *ADMINS*\n\n${list || "Aucun administrateur trouvé."}`,
      mentions: admins.map(p => p.id)
    });
    return true;
  }

  if (command === "members") {
    await sock.sendMessage(jid, {
      text: `👥 Ce groupe contient *${participants.length} membres*.`
    });
    return true;
  }

  if (command === "tagall") {
    const mentions = participants.map(p => p.id);
    const text = participants
      .map(p => `@${p.id.split("@")[0]}`)
      .join(" ");

    await sock.sendMessage(jid, {
      text: `📢 *MADO-BOT*\n\n${text}`,
      mentions
    });
    return true;
  }

  return false;
}

module.exports = { handleGroup };