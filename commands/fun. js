const choices = [
  "Pierre 🪨",
  "Papier 📄",
  "Ciseaux ✂️"
];

async function handleFun(command, args, sock, jid) {
  const text = args.join(" ");

  switch (command) {

    case "dice": {
      const number = Math.floor(Math.random() * 6) + 1;

      await sock.sendMessage(jid, {
        text: `🎲 Résultat : *${number}*`
      });

      return true;
    }

    case "coin": {
      const result = Math.random() < 0.5
        ? "🪙 PILE"
        : "🪙 FACE";

      await sock.sendMessage(jid, {
        text: result
      });

      return true;
    }

    case "8ball": {
      const answers = [
        "Oui.",
        "Non.",
        "Peut-être.",
        "Certainement.",
        "Je ne sais pas encore.",
        "Demande-moi plus tard."
      ];

      await sock.sendMessage(jid, {
        text:
          `🎱 Question : ${text || "—"}\n\n` +
          `➡️ ${answers[Math.floor(Math.random() * answers.length)]}`
      });

      return true;
    }

    case "choose": {
      if (!text) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .choose cinéma,football"
        });
        return true;
      }

      const list = text
        .split(",")
        .map(x => x.trim())
        .filter(Boolean);

      if (!list.length) return true;

      const selected =
        list[Math.floor(Math.random() * list.length)];

      await sock.sendMessage(jid, {
        text: `🎯 Je choisis : *${selected}*`
      });

      return true;
    }

    case "rps": {
      const player = text.toLowerCase();

      if (!["pierre", "papier", "ciseaux"].includes(player)) {
        await sock.sendMessage(jid, {
          text:
            "❌ Choisis : pierre, papier ou ciseaux.\n" +
            "Exemple : .rps pierre"
        });
        return true;
      }

      const bot =
        choices[Math.floor(Math.random() * choices.length)]
          .split(" ")[0]
          .toLowerCase();

      let result = "🤝 Égalité !";

      if (
        (player === "pierre" && bot === "ciseaux") ||
        (player === "papier" && bot === "pierre") ||
        (player === "ciseaux" && bot === "papier")
      ) {
        result = "🎉 Tu as gagné !";
      } else if (player !== bot) {
        result = "🤖 MADO-BOT gagne !";
      }

      await sock.sendMessage(jid, {
        text:
          `🎮 *PIERRE-PAPIER-CISEAUX*\n\n` +
          `👤 Toi : ${player}\n` +
          `🤖 MADO-BOT : ${bot}\n\n` +
          result
      });

      return true;
    }

    case "randomnumber": {
      const min = Number(args[0]);
      const max = Number(args[1]);

      if (
        !Number.isFinite(min) ||
        !Number.isFinite(max) ||
        min > max
      ) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .randomnumber 1 100"
        });
        return true;
      }

      const number =
        Math.floor(Math.random() * (max - min + 1)) + min;

      await sock.sendMessage(jid, {
        text: `🎲 Nombre : *${number}*`
      });

      return true;
    }

    default:
      return false;
  }
}

module.exports = { handleFun };