const axios = require("axios");
const { AI_API_KEY } = require("../config");

async function askAI(prompt) {
  if (!AI_API_KEY) {
    return "⚠️ Configure d'abord AI_API_KEY dans ton fichier .env.";
  }

  try {
    const response = await axios.post(
      "https://api.openai.com/v1/chat/completions",
      {
        model: "gpt-4o-mini",
        messages: [
          {
            role: "user",
            content: prompt
          }
        ]
      },
      {
        headers: {
          Authorization: `Bearer ${AI_API_KEY}`,
          "Content-Type": "application/json"
        }
      }
    );

    return (
      response.data.choices?.[0]?.message?.content ||
      "❌ Aucune réponse."
    );
  } catch (error) {
    return "❌ Impossible de contacter le service IA.";
  }
}

async function handleAITools(command, args, sock, jid) {
  const text = args.join(" ");

  const prompts = {
    askai: `Réponds clairement à cette question : ${text}`,
    question: `Réponds à cette question avec des explications simples : ${text}`,
    tutor: `Agis comme un tuteur et explique progressivement : ${text}`,
    summarizeai: `Fais un résumé clair et court de : ${text}`,
    rewrite: `Réécris ce texte de manière plus claire : ${text}`,
    correct: `Corrige les fautes de ce texte sans changer son sens : ${text}`,
    ideas: `Donne plusieurs idées créatives sur ce sujet : ${text}`,
    definition: `Donne une définition simple et un exemple pour : ${text}`,
    compare: `Compare les éléments suivants de manière neutre : ${text}`,
    plan: `Crée un plan organisé pour ce sujet : ${text}`
  };

  if (!prompts[command]) return false;

  if (!text) {
    await sock.sendMessage(jid, {
      text: `❌ Exemple : .${command} explique la photosynthèse`
    });
    return true;
  }

  await sock.sendMessage(jid, {
    text: "🧠 MADO-BOT IA prépare la réponse..."
  });

  const answer = await askAI(prompts[command]);

  await sock.sendMessage(jid, {
    text: `🤖 *MADO-BOT IA*\n\n${answer}`
  });

  return true;
}

module.exports = { handleAITools };