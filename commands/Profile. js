async function handleProfile(command, args, sock, jid, message) {
  switch (command) {

    case "profile":
    case "profil": {
      const sender =
        message.key.participant ||
        message.key.remoteJid;

      const number = sender.split("@")[0];

      await sock.sendMessage(jid, {
        text:
          `👤 *PROFIL UTILISATEUR*\n\n` +
          `📱 Numéro : +${number}\n` +
          `🆔 ID : ${sender}\n` +
          `🤖 Bot : MADO-BOT`
      });

      return true;
    }

    case "jid":
      await sock.sendMessage(jid, {
        text: `🆔 *JID actuel :*\n${jid}`
      });
      return true;

    case "myid": {
      const sender =
        message.key.participant ||
        message.key.remoteJid;

      await sock.sendMessage(jid, {
        text: `🆔 *TON ID WHATSAPP*\n\n${sender}`
      });

      return true;
    }

    case "whois": {
      const mentioned =
        message.message?.extendedTextMessage?.contextInfo
          ?.mentionedJid || [];

      if (!mentioned.length) {
        await sock.sendMessage(jid, {
          text: "❌ Mentionne une personne.\nExemple : .whois @membre"
        });
        return true;
      }

      const user = mentioned[0];

      await sock.sendMessage(jid, {
        text:
          `🔎 *INFORMATIONS*\n\n` +
          `👤 Utilisateur : @${user.split("@")[0]}\n` +
          `🆔 ID : ${user}`,
        mentions: [user]
      });

      return true;
    }

    default:
      return false;
  }
}

module.exports = { handleProfile };