async function isAdmin(sock, jid, user) {
  const metadata = await sock.groupMetadata(jid);
  const participant = metadata.participants.find(
    p => p.id === user
  );

  return participant &&
    (participant.admin === "admin" || participant.admin === "superadmin");
}

async function handleAdmin(command, args, sock, jid, message) {
  const commands = [
    "ban",
    "kick",
    "promote",
    "demote",
    "mute",
    "unmute"
  ];

  if (!commands.includes(command)) return false;

  if (!jid.endsWith("@g.us")) {
    await sock.sendMessage(jid, {
      text: "❌ Cette commande fonctionne uniquement dans un groupe."
    });
    return true;
  }

  const sender = message.key.participant || message.key.remoteJid;

  if (!(await isAdmin(sock, jid, sender))) {
    await sock.sendMessage(jid, {
      text: "⛔ Cette commande est réservée aux administrateurs."
    });
    return true;
  }

  const mentioned =
    message.message?.extendedTextMessage?.contextInfo?.mentionedJid || [];

  if (!mentioned.length) {
    await sock.sendMessage(jid, {
      text: `❌ Mentionne un membre.\nExemple : .${command} @membre`
    });
    return true;
  }

  const target = mentioned[0];

  try {
    if (command === "ban" || command === "kick") {
      await sock.groupParticipantsUpdate(
        jid,
        [target],
        "remove"
      );

      await sock.sendMessage(jid, {
        text: `🚫 @${target.split("@")[0]} a été retiré du groupe.`,
        mentions: [target]
      });

      return true;
    }

    if (command === "promote") {
      await sock.groupParticipantsUpdate(
        jid,
        [target],
        "promote"
      );

      await sock.sendMessage(jid, {
        text: `👑 @${target.split("@")[0]} est maintenant administrateur.`,
        mentions: [target]
      });

      return true;
    }

    if (command === "demote") {
      await sock.groupParticipantsUpdate(
        jid,
        [target],
        "demote"
      );

      await sock.sendMessage(jid, {
        text: `⬇️ @${target.split("@")[0]} n'est plus administrateur.`,
        mentions: [target]
      });

      return true;
    }

    return false;
  } catch (error) {
    console.error(error);

    await sock.sendMessage(jid, {
      text: "❌ Action impossible. Vérifie que MADO-BOT est administrateur du groupe."
    });

    return true;
  }
}

module.exports = { handleAdmin };