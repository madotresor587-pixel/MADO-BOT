async function handleModeration(command, args, sock, jid, message) {
  const commands = [
    "warn",
    "warnings",
    "clearwarn",
    "groupadmins",
    "membercount"
  ];

  if (!commands.includes(command)) return false;

  if (!jid.endsWith("@g.us")) {
    await sock.sendMessage(jid, {
      text: "❌ Cette commande fonctionne uniquement dans un groupe."
    });
    return true;
  }

  const metadata = await sock.groupMetadata(jid);

  const sender =
    message.key.participant ||
    message.key.remoteJid;

  const senderMember = metadata.participants.find(
    p => p.id === sender
  );

  const isAdmin =
    senderMember &&
    (senderMember.admin === "admin" ||
      senderMember.admin === "superadmin");

  if (!isAdmin) {
    await sock.sendMessage(jid, {
      text: "⛔ Cette commande est réservée aux administrateurs."
    });
    return true;
  }

  const mentioned =
    message.message?.extendedTextMessage?.contextInfo
      ?.mentionedJid || [];

  if (command === "membercount") {
    await sock.sendMessage(jid, {
      text: `👥 Nombre de membres : *${metadata.participants.length}*`
    });
    return true;
  }

  if (command === "groupadmins") {
    const admins = metadata.participants.filter(
      p => p.admin === "admin" || p.admin === "superadmin"
    );

    const list = admins
      .map((p, i) => `${i + 1}. @${p.id.split("@")[0]}`)
      .join("\n");

    await sock.sendMessage(jid, {
      text: `👑 *ADMINISTRATEURS*\n\n${list}`,
      mentions: admins.map(p => p.id)
    });

    return true;
  }

  if (command === "warn") {
    if (!mentioned.length) {
      await sock.sendMessage(jid, {
        text: "❌ Mentionne le membre à avertir."
      });
      return true;
    }

    await sock.sendMessage(jid, {
      text:
        `⚠️ @${mentioned[0].split("@")[0]} a reçu un avertissement.\n\n` +
        `📌 Utilise .warnings @membre pour consulter les avertissements.`,
      mentions: [mentioned[0]]
    });

    return true;
  }

  if (command === "warnings") {
    if (!mentioned.length) {
      await sock.sendMessage(jid, {
        text: "❌ Mentionne un membre."
      });
      return true;
    }

    await sock.sendMessage(jid, {
      text:
        `⚠️ Avertissements de @${mentioned[0].split("@")[0]} :\n\n` +
        `ℹ️ Le stockage permanent des avertissements sera ajouté dans la base de données finale.`,
      mentions: [mentioned[0]]
    });

    return true;
  }

  if (command === "clearwarn") {
    if (!mentioned.length) {
      await sock.sendMessage(jid, {
        text: "❌ Mentionne un membre."
      });
      return true;
    }

    await sock.sendMessage(jid, {
      text:
        `✅ Avertissements réinitialisés pour @${mentioned[0].split("@")[0]}.`,
      mentions: [mentioned[0]]
    });

    return true;
  }

  return false;
}

module.exports = { handleModeration };