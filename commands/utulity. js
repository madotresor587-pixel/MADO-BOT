async function handleUtility(command, args, sock, jid) {
  const text = args.join(" ");

  switch (command) {

    case "calc": {
      if (!text) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .calc 25*4+10"
        });
        return true;
      }

      // Calcul simple et limité aux caractères mathématiques.
      if (!/^[0-9+\-*/().%\s]+$/.test(text)) {
        await sock.sendMessage(jid, {
          text: "❌ Expression mathématique invalide."
        });
        return true;
      }

      try {
        const result = Function(`"use strict"; return (${text})`)();

        await sock.sendMessage(jid, {
          text: `🧮 *CALCUL*\n\n${text} = *${result}*`
        });
      } catch {
        await sock.sendMessage(jid, {
          text: "❌ Impossible de calculer cette expression."
        });
      }

      return true;
    }

    case "countdown": {
      const seconds = Number(args[0]);

      if (!Number.isInteger(seconds) || seconds < 1 || seconds > 3600) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .countdown 30\nMaximum : 3600 secondes."
        });
        return true;
      }

      await sock.sendMessage(jid, {
        text: `⏳ Compte à rebours lancé : *${seconds} secondes*`
      });

      setTimeout(async () => {
        try {
          await sock.sendMessage(jid, {
            text: "⏰ *Temps écoulé !*"
          });
        } catch {}
      }, seconds * 1000);

      return true;
    }

    case "uuid": {
      const id = crypto.randomUUID();

      await sock.sendMessage(jid, {
        text: `🆔 *UUID généré*\n\n${id}`
      });

      return true;
    }

    case "timestamp": {
      await sock.sendMessage(jid, {
        text:
          `⏱️ *TIMESTAMP*\n\n` +
          `Unix : ${Math.floor(Date.now() / 1000)}\n` +
          `Millisecondes : ${Date.now()}`
      });

      return true;
    }

    case "charcount": {
      if (!text) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .charcount Bonjour MADO"
        });
        return true;
      }

      await sock.sendMessage(jid, {
        text:
          `🔢 *COMPTEUR DE TEXTE*\n\n` +
          `Caractères : ${text.length}\n` +
          `Mots : ${text.trim().split(/\s+/).length}`
      });

      return true;
    }

    default:
      return false;
  }
}

module.exports = { handleUtility };