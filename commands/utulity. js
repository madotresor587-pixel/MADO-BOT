const crypto = require("crypto");

async function handleUtility(command, args, sock, jid) {
  const text = args.join(" ");

  switch (command) {

    case "calc": {
      if (!text) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .calc 25*4+10"
        });
        return true;
      }

      if (!/^[0-9+\-*/().%\s]+$/.test(text)) {
        await sock.sendMessage(jid, {
          text: "❌ Expression mathématique invalide."
        });
        return true;
      }

      try {
        const result = Function(
          `"use strict"; return (${text})`
        )();

        await sock.sendMessage(jid, {
          text: `🧮 ${text} = *${result}*`
        });
      } catch {
        await sock.sendMessage(jid, {
          text: "❌ Impossible de calculer."
        });
      }

      return true;
    }

    case "countdown": {
      const seconds = Number(args[0]);

      if (
        !Number.isInteger(seconds) ||
        seconds < 1 ||
        seconds > 3600
      ) {
        await sock.sendMessage(jid, {
          text:
            "❌ Exemple : .countdown 30\n" +
            "Maximum : 3600 secondes."
        });
        return true;
      }

      await sock.sendMessage(jid, {
        text: `⏳ Compte à rebours : *${seconds}s*`
      });

      setTimeout(async () => {
        try {
          await sock.sendMessage(jid, {
            text: "⏰ *Temps écoulé !*"
          });
        } catch {}
      }, seconds * 1000);

      return true;
    }

    case "uuid": {
      const id = crypto.randomUUID();

      await sock.sendMessage(jid, {
        text: `🆔 *UUID*\n\n${id}`
      });

      return true;
    }

    case "timestamp":
      await sock.sendMessage(jid, {
        text:
          `⏱️ *TIMESTAMP*\n\n` +
          `Unix : ${Math.floor(Date.now() / 1000)}\n` +
          `Milliseconds : ${Date.now()}`
      });
      return true;

    case "charcount":
      if (!text) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .charcount Bonjour Mado"
        });
        return true;
      }

      await sock.sendMessage(jid, {
        text:
          `🔢 Caractères : *${text.length}*\n` +
          `📝 Mots : *${text.trim().split(/\s+/).length}*`
      });

      return true;

    default:
      return false;
  }
}

module.exports = { handleUtility };