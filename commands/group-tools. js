async function handleGroupTools(command, args, sock, jid, message) {
  const commands = [
    "groupopen",
    "groupclose",
    "setname",
    "setdesc",
    "grouplink"
  ];

  if (!commands.includes(command)) return false;

  if (!jid.endsWith("@g.us")) {
    await sock.sendMessage(jid, {
      text: "❌ Cette commande fonctionne uniquement dans un groupe."
    });
    return true;
  }

  const metadata = await sock.groupMetadata(jid);

  const sender =
    message.key.participant ||
    message.key.remoteJid;

  const member = metadata.participants.find(
    p => p.id === sender
  );

  const isAdmin =
    member &&
    (member.admin === "admin" || member.admin === "superadmin");

  if (!isAdmin) {
    await sock.sendMessage(jid, {
      text: "⛔ Cette commande est réservée aux administrateurs."
    });
    return true;
  }

  try {
    if (command === "groupopen") {
      await sock.groupSettingUpdate(jid, "not_announcement");

      await sock.sendMessage(jid, {
        text: "🔓 Le groupe est maintenant ouvert aux messages."
      });

      return true;
    }

    if (command === "groupclose") {
      await sock.groupSettingUpdate(jid, "announcement");

      await sock.sendMessage(jid, {
        text: "🔒 Le groupe est maintenant réservé aux administrateurs."
      });

      return true;
    }

    if (command === "setname") {
      const name = args.join(" ");

      if (!name) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .setname MADO-BOT OFFICIEL"
        });
        return true;
      }

      await sock.groupUpdateSubject(jid, name);

      await sock.sendMessage(jid, {
        text: `✅ Nom du groupe changé en : *${name}*`
      });

      return true;
    }

    if (command === "setdesc") {
      const description = args.join(" ");

      if (!description) {
        await sock.sendMessage(jid, {
          text: "❌ Exemple : .setdesc Bienvenue dans le groupe MADO-BOT"
        });
        return true;
      }

      await sock.groupUpdateDescription(jid, description);

      await sock.sendMessage(jid, {
        text: "✅ Description du groupe mise à jour."
      });

      return true;
    }

    if (command === "grouplink") {
      const code = await sock.groupInviteCode(jid);

      await sock.sendMessage(jid, {
        text: `🔗 *LIEN DU GROUPE*\n\nhttps://chat.whatsapp.com/${code}`
      });

      return true;
    }

  } catch (error) {
    console.error(error);

    await sock.sendMessage(jid, {
      text: "❌ Impossible d'effectuer cette action. Vérifie que MADO-BOT est administrateur."
    });

    return true;
  }

  return false;
}

module.exports = { handleGroupTools };